{%  render 'partials/head.liquid' %}

{%  render 'partials/headerNieuws.liquid' %}

<main class="main-news-detail">
    <picture>
        <source type="image/avif" srcset="https://fdnd-agency.directus.app/assets/{{artikel.image}}?format=avif">
        <source type="image/webp" srcset="https://fdnd-agency.directus.app/assets/{{artikel.image}}?format=webp">
        <img width="150" height="100" loading="lazy" src="https://fdnd-agency.directus.app/assets/{{newsItem.image}}" alt="{{newsItem.title}}">
    </picture>
    <time datetime="{{ artikel.date }}">Geplaatst: {{ artikel.date | date: '%d-%m-%Y'}}</time>
    <p>
        {{ artikel.title }}
    </p>
    <p>
        {{ artikel.body }}
    </p>

    <div class="detail-question">
        <p>
            {{ artikel.question }}
            Hoe ziet de duidendblad er bij jou uit?
        </p>
        <p>Laat het weten in de berichten hieronder!</p>
    </div>

    {%  render 'partials/commentForm.liquid', berichten: berichten, artikel: artikel, error: error, gelukt: gelukt %}
</main>

{%  render 'partials/navbar.liquid', huidigPad: huidigPad %}

{%  render 'partials/foot.liquid' %}